#!/usr/bin/env python3

from __future__ import annotations

import argparse
import tomllib
from pathlib import Path


def is_private_use(cp: int) -> bool:
    return 0xE000 <= cp <= 0xF8FF or 0xF0000 <= cp <= 0xFFFFD or 0x100000 <= cp <= 0x10FFFD


def walk(value, path=""):
    if isinstance(value, dict):
        for key, child in value.items():
            yield from walk(child, f"{path}.{key}" if path else key)
    elif isinstance(value, list):
        for i, child in enumerate(value):
            yield from walk(child, f"{path}[{i}]")
    elif isinstance(value, str):
        yield path, value


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("config", type=Path)
    args = parser.parse_args()

    with args.config.open("rb") as f:
        config = tomllib.load(f)

    errors = []

    # Vingilot's visual policy:
    #
    #   ASCII text/punctuation: allowed.
    #   Nerd Font / Powerline private-use glyphs: allowed.
    #   Everything else: rejected.
    #
    # This catches emoji, emoji variation selectors, pictographs, and
    # accidental clipboard corruption before installation.
    for path, value in walk(config):
        for ch in value:
            cp = ord(ch)

            if cp < 0x80 or is_private_use(cp):
                continue

            errors.append(f"{path}: forbidden non-ASCII/non-PUA U+{cp:04X} {ch!r}")

    status = config.get("status", {})
    if status.get("map_symbol", False):
        errors.append("status.map_symbol must be false: Starship mappings can emit emoji")

    if errors:
        print("Vingilot symbol policy FAILED:")
        for error in errors:
            print(f"  - {error}")
        return 1

    print("Vingilot symbol policy: OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
